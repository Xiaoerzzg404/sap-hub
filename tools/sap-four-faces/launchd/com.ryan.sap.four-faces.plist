<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd template for sap-four-faces (HARDENING §B).

  This is a TEMPLATE. Claude Code does NOT `launchctl load` it — loading
  is a Ryan-only action. To install:

    cp ~/sap-hub/tools/sap-four-faces/launchd/com.ryan.sap.four-faces.plist \
       ~/Library/LaunchAgents/com.ryan.sap.four-faces.plist
    # (edit paths below if your $HOME is not /Users/openclawxiaoer)
    launchctl unload ~/Library/LaunchAgents/com.ryan.sap.four-faces.plist 2>/dev/null
    launchctl load   ~/Library/LaunchAgents/com.ryan.sap.four-faces.plist

  Default schedule: 21:30 Asia/Tokyo daily (晚上跑 → 编排器自己算次日 edition).
  Edit StartCalendarInterval below to change.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ryan.sap.four-faces</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>/Users/openclawxiaoer/sap-hub/tools/sap-four-faces/launchd/daily.sh</string>
  </array>

  <!-- Daily at 21:30 local time (Asia/Tokyo per CLAUDE.md). -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>21</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/openclawxiaoer/sap-hub/tools/sap-four-faces/logs/four-faces.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/openclawxiaoer/sap-hub/tools/sap-four-faces/logs/four-faces.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/openclawxiaoer</string>
  </dict>
</dict>
</plist>
