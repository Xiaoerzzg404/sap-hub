{
  "name": "@sap-jp/speaking-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "convert:content": "node scripts/convert-content.mjs",
    "ledger:snapshot": "node scripts/site-ledger.mjs snapshot",
    "ledger:diff": "node scripts/site-ledger.mjs diff",
    "ledger:check": "node scripts/site-ledger.mjs check",
    "ledger:rebuild-plan": "node scripts/site-ledger.mjs rebuild-plan",
    "tts": "node scripts/generate-tts.mjs",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:push": "drizzle-kit push",
    "drizzle:studio": "drizzle-kit studio",
    "seed-db": "node scripts/seed-db.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "cd ../../.. && projects/4-sap-training/web/node_modules/.bin/husky projects/4-sap-training/web/.husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
